+// ✨ PURR GPU-OFFLOAD GATE: 0 keeps every tensor on CPU (the previous, CPU-only
+// behavior); -1 lets llama.cpp offload the whole talker/predictor to a registered GPU
+// backend (Adreno OpenCL). The host app sets this before lunavox_create().
+static int32_t g_default_n_gpu_layers = 0;
+
+void set_default_n_gpu_layers(int32_t n_gpu_layers) {
+    g_default_n_gpu_layers = n_gpu_layers;
+}
+
+int32_t default_n_gpu_layers() {
+    return g_default_n_gpu_layers;
+}
